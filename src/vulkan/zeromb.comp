#version 450
// zeromb.comp -- batch method-B zero refinement, window-relative, df32.
//
// One thread per zero in a window anchored at t_base (the ARB-computed Lambert-W
// location).  The host folds the huge base phases (m*log p*t_base) mod 2*pi in
// ARB once per window; here we only ever touch O(1) quantities:
//   phi[k] in [0,2pi),  amp[k]=1/(m p^{m/2}),  om[k]=m log p,  delta ~ gap.
// F_B(t_base+delta) = N0(t_base+delta) + (1/pi) Im log P_X, with
//   Im log P_X = -sum_k amp[k] sin(phi[k] + om[k]*delta).
// We bisect F_B - (integer target) in delta; t_n = t_base + delta (added in ARB).
//
// Robustness (verified against mpmath to ~1e-6 at moderate X; large-X needs both):
//   * the sin argument phi+om*delta is RANGE-REDUCED mod 2pi -- GPU sin loses
//     accuracy past ~2pi (Intel Mesa included), which otherwise corrupts the sum
//     once high-omega primes enter (large X);
//   * the prime sum uses a df32 (two-float / TwoSum) accumulator, so ~1e5 terms
//     accumulate without fp32 drift.

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly  buffer Phi { float phi[]; };  // (m log p . t_base) mod 2pi
layout(std430, binding = 1) readonly  buffer Amp { float amp[]; };  // 1/(m p^{m/2})
layout(std430, binding = 2) readonly  buffer Om  { float om[];  };  // m log p
layout(std430, binding = 3) writeonly buffer Out { float delta[]; };

layout(push_constant) uniform PC {
    uint  P;     // number of prime-powers
    uint  M;     // number of zeros in the window
    int   Wc;    // centre index (so integer offset dn = thread - Wc)
    float rho;   // N0'(t_base) = local zero density
    float rho1;  // N0''(t_base) (curvature; ~0 at large height)
    float c0;    // N0(t_base) - (n_centre - 1/2)   [ARB residual, O(1)]
    float gap;   // 1 / rho
} pc;

const float INV_PI     = 0.318309886183790672;
const float TWO_PI     = 6.283185307179586477;
const float INV_TWO_PI = 0.159154943091895336;

// TwoSum: hi+lo = a+b exactly (Knuth).
vec2 twoSum(float a, float b) { float s = a + b; float z = s - a; return vec2(s, (a - (s - z)) + (b - z)); }

// F_B(t_base + d) - target(dn), all O(1).  Range-reduced sin + df32 reduction.
float g(float d, int dn) {
    float sm = pc.c0 + pc.rho * d + 0.5 * pc.rho1 * d * d - float(dn);  // N0 - target
    vec2 S = vec2(0.0, 0.0);                          // df32 accumulator of sum_k amp sin
    for (uint k = 0u; k < pc.P; ++k) {
        float a = phi[k] + om[k] * d;
        a -= TWO_PI * floor(a * INV_TWO_PI);          // reduce to [0,2pi) for sin accuracy
        float term = amp[k] * sin(a);
        vec2 t1 = twoSum(S.x, term);                  // df32 add
        S = twoSum(t1.x, t1.y + S.y);
    }
    return sm - INV_PI * (S.x + S.y);                 // F_B = N0 + Im log P_X / pi
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.M) return;
    int   dn = int(i) - pc.Wc;          // integer offset of this zero from centre
    float d0 = float(dn) * pc.gap;      // smooth-seeded prediction (independent!)
    float lo = d0 - 0.9 * pc.gap, hi = d0 + 0.9 * pc.gap;
    float glo = g(lo, dn), ghi = g(hi, dn);
    if ((glo > 0.0) == (ghi > 0.0)) {   // widen once if the bracket missed
        lo = d0 - 1.8 * pc.gap; hi = d0 + 1.8 * pc.gap;
        glo = g(lo, dn); ghi = g(hi, dn);
    }
    if ((glo > 0.0) == (ghi > 0.0)) { delta[i] = d0; return; }  // fallback: predicted
    for (int it = 0; it < 40; ++it) {   // lockstep bisection
        float mid = 0.5 * (lo + hi), gm = g(mid, dn);
        if ((glo > 0.0) == (gm > 0.0)) { lo = mid; glo = gm; } else { hi = mid; }
    }
    delta[i] = 0.5 * (lo + hi);
}
